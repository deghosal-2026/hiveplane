# HivePlane local configuration.
# Copy to `.env` (scripts/dev-up.sh does this automatically) and adjust as needed.
# `.env` is gitignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
HIVEPLANE_ENVIRONMENT=local
HIVEPLANE_DEBUG=false

# ---------------------------------------------------------------------------
# Configuration profiles (M23, #120)
# ---------------------------------------------------------------------------
# Compose ships one env template per LLM backend. Select a profile and its env
# file together; profiles also gate optional services (`webhook-sink`):
#   docker compose --env-file .env.ci    --profile ci    up -d
#   docker compose --env-file .env.local --profile local up -d
#   docker compose --env-file .env.cloud --profile cloud up -d
#
# Provider matrix (see docs/field-test/v0.1.0/docker-test-plan.md §6):
#   ci    HIVEPLANE_MODEL__PROVIDER=fake    hermetic: no network, no secrets
#   local HIVEPLANE_MODEL__PROVIDER=local   + BASE_URL=http://host.docker.internal:8000/v1
#         (OMLX on the host; host port 8000 is reserved for it — containers use
#          host.docker.internal, native runs use http://127.0.0.1:8000/v1)
#   cloud HIVEPLANE_MODEL__PROVIDER=cloud   + BASE_URL=https://api.openai.com/v1
#
# Model provider settings (defaults shown; a profile file overrides them):
# HIVEPLANE_MODEL__PROVIDER=fake
# HIVEPLANE_MODEL__BASE_URL=
# HIVEPLANE_MODEL__API_KEY=
# HIVEPLANE_MODEL__DEFAULT_MODEL=
# HIVEPLANE_MODEL__MODEL_ALIASES={"gpt-4o-2024-08-06": "openai/gpt-4o/2024-08-06"}
#   Map server-reported model names to the canonical identity runs are bound to;
#   without a matching alias every model call raises ModelIdentityMismatchError (T11).
# HIVEPLANE_MODEL__REPLAY_FILE=deploy/testdata/llm/replay.json
#   Fake-provider replay keyed by request hash (M23 #137); a missing entry for a
#   request fails the call loudly. Regenerate with scripts/generate_replay.py.

# ---------------------------------------------------------------------------
# PostgreSQL (system of record)
# ---------------------------------------------------------------------------
POSTGRES_DB=hiveplane
POSTGRES_USER=hiveplane
POSTGRES_PASSWORD=hiveplane
POSTGRES_PORT=5432

HIVEPLANE_DATABASE__HOST=localhost
HIVEPLANE_DATABASE__PORT=5432
HIVEPLANE_DATABASE__NAME=hiveplane
HIVEPLANE_DATABASE__USER=hiveplane
HIVEPLANE_DATABASE__PASSWORD=hiveplane

# ---------------------------------------------------------------------------
# Redis (queue / signaling)
# ---------------------------------------------------------------------------
REDIS_PORT=6379

HIVEPLANE_REDIS__HOST=localhost
HIVEPLANE_REDIS__PORT=6379
HIVEPLANE_REDIS__DB=0
# HIVEPLANE_REDIS__PASSWORD=

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

HIVEPLANE_OTEL__ENDPOINT=http://localhost:4318
HIVEPLANE_OTEL__SERVICE_NAME=hiveplane
HIVEPLANE_OTEL__TRACE_SAMPLING=1.0
HIVEPLANE_OTEL__METRICS_ENABLED=true
HIVEPLANE_OTEL__LOGS_ENABLED=true

# ---------------------------------------------------------------------------
# Certification thresholds
# ---------------------------------------------------------------------------
HIVEPLANE_CERTIFICATION__STAGING__MIN_PASS_RATE=0.70
HIVEPLANE_CERTIFICATION__STAGING__MAX_CRITICAL_FAILURES=2
HIVEPLANE_CERTIFICATION__STAGING__MAX_P95_LATENCY_MS=60000
HIVEPLANE_CERTIFICATION__PRODUCTION__MIN_PASS_RATE=0.85
HIVEPLANE_CERTIFICATION__PRODUCTION__MAX_CRITICAL_FAILURES=0
HIVEPLANE_CERTIFICATION__PRODUCTION__MAX_P95_LATENCY_MS=30000
HIVEPLANE_CERTIFICATION__PRODUCTION__MIN_PRODUCTION_RUNS_SURVIVED=50
HIVEPLANE_CERTIFICATION__RE_CERT_INTERVAL_DAYS=14
HIVEPLANE_CERTIFICATION__DRIFT_THRESHOLD_PASS_RATE=0.10
HIVEPLANE_CERTIFICATION__MAX_NEW_FAILURES=2

# ---------------------------------------------------------------------------
# Sandbox defaults
# ---------------------------------------------------------------------------
HIVEPLANE_SANDBOX__ENABLED=true
HIVEPLANE_SANDBOX__DEFAULTS__MEMORY_MB=512
HIVEPLANE_SANDBOX__DEFAULTS__CPU_CORES=1.0
HIVEPLANE_SANDBOX__DEFAULTS__WALL_CLOCK_S=300
HIVEPLANE_SANDBOX__DEFAULTS__EGRESS_MODE=restricted
HIVEPLANE_SANDBOX__DEFAULTS__FILESYSTEM=isolated

# ---------------------------------------------------------------------------
# Result fan-out
# ---------------------------------------------------------------------------
HIVEPLANE_FANOUT__ENABLED=true
HIVEPLANE_FANOUT__TIMEOUT_S=10
HIVEPLANE_FANOUT__MAX_RETRIES=3
# HIVEPLANE_FANOUT__SLACK_WEBHOOK_URL=
# HIVEPLANE_FANOUT__GENERIC_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Desired-state reconciliation (GitOps)
# ---------------------------------------------------------------------------
HIVEPLANE_RECONCILE__ENABLED=false
HIVEPLANE_RECONCILE__POLL_INTERVAL_S=60
# Destructive actions (deregister, quarantine) are blocked unless explicitly allowed.
HIVEPLANE_RECONCILE__ALLOW_DESTRUCTIVE=false
# An empty desired set cannot cascade to mass deregistration unless explicitly allowed.
HIVEPLANE_RECONCILE__ALLOW_EMPTY=false
HIVEPLANE_RECONCILE__MAX_DESTRUCTIVE_PER_RUN=10
HIVEPLANE_RECONCILE__REQUIRE_DESTRUCTIVE_CONFIRMATION=true
# HIVEPLANE_RECONCILE__PINNED_FIELDS=["spec.budget.per_day_usd"]

# ---------------------------------------------------------------------------
# Local stack ports
# ---------------------------------------------------------------------------
API_PORT=8000
TEMPO_PORT=3200
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
