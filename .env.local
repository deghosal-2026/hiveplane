# HivePlane local-LLM configuration profile (Ollama, OpenAI-compatible, temperature 0).
# Usage: docker compose --env-file .env.local --profile local up -d
# See .env.example for the full setting list.

HIVEPLANE_ENVIRONMENT=local
HIVEPLANE_DEBUG=false

# Local provider served by the `ollama` compose service.
HIVEPLANE_MODEL__PROVIDER=local
HIVEPLANE_MODEL__BASE_URL=http://ollama:11434/v1
HIVEPLANE_MODEL__DEFAULT_MODEL=local/qwen2.5/7b

# Host port for the `ollama` service.
OLLAMA_PORT=11434