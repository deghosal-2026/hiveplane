# HivePlane local-LLM configuration profile (OMLX, OpenAI-compatible, temperature 0).
# Usage: docker compose --env-file .env.local up -d
# See .env.example for the full setting list.

HIVEPLANE_ENVIRONMENT=local
HIVEPLANE_DEBUG=false

# OMLX (mlx_lm.server) owns HOST port 8000 — nothing else may bind it.
# Containers reach the host via host.docker.internal; when running the control
# plane natively (hiveplane serve), use http://127.0.0.1:8000/v1 instead.
HIVEPLANE_MODEL__PROVIDER=local
HIVEPLANE_MODEL__BASE_URL=http://host.docker.internal:8000/v1
HIVEPLANE_MODEL__DEFAULT_MODEL=omlx/qwen2.5-7b-instruct/4bit
# Map the OMLX-served model to the canonical identity runs are bound to;
# without this every model call raises ModelIdentityMismatchError (T11).
# Adjust the tag to the model your OMLX server actually serves, then certify
# with: hiveplane certify <workload> --model-identity omlx/<served-model-id>.
HIVEPLANE_MODEL__MODEL_ALIASES={"mlx-community/Qwen2.5-7B-Instruct-4bit": "omlx/qwen2.5-7b-instruct/4bit"}