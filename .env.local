# HivePlane local-LLM configuration profile (OMLX, OpenAI-compatible, temperature 0).
# Usage: docker compose --env-file .env.local up -d
# See .env.example for the full setting list.

HIVEPLANE_ENVIRONMENT=local
HIVEPLANE_DEBUG=false

# OMLX (mlx_lm.server) owns HOST port 8000 — nothing else may bind it.
# Containers reach the host via host.docker.internal; when running the control
# plane natively (hiveplane serve), use http://127.0.0.1:8000/v1 instead.
HIVEPLANE_MODEL__PROVIDER=local
HIVEPLANE_MODEL__BASE_URL=http://host.docker.internal:8000/v1
HIVEPLANE_MODEL__DEFAULT_MODEL=omlx/qwen3-4b-instruct-2507/4bit
# Map the OMLX-served model to the canonical identity runs are bound to;
# without this every model call raises ModelIdentityMismatchError (T11).
# The served id must match `GET /v1/models` (check: curl 127.0.0.1:8000/v1/models);
# adjust it to the model your OMLX server actually serves, then certify with:
#   hiveplane certify <workload> --model-identity omlx/<served-model-id>.
HIVEPLANE_MODEL__MODEL_ALIASES={"Qwen3-4B-Instruct-2507-4bit": "omlx/qwen3-4b-instruct-2507/4bit"}

# Execute real agents and certify through the runtime adapter (M23, #144).
HIVEPLANE_EXECUTION__ADAPTER=auto
HIVEPLANE_CERTIFICATION__EXECUTOR=adapter
HIVEPLANE_CERTIFICATION__CORPORA_DIR=field_test

# Field-test budget profile (S5): price the local model identity and drop the
# zero-cost prefix exemption so real token usage is charged and a tiny per-run
# ceiling can be exceeded. Non-field-test profiles keep local models free.
HIVEPLANE_BUDGET__PRICES={"omlx/qwen3-4b-instruct-2507/4bit": {"input_per_1k": 150.0, "output_per_1k": 600.0}}
HIVEPLANE_BUDGET__ZERO_COST_PREFIXES=[]

# Field-test profile: the production survival gate (fleet default 50 runs while
# provisional, DD-09) is lowered to 0 so the certified control loop can be
# demonstrated in a single stack run. The benchmark thresholds themselves are
# NOT relaxed — production still requires 0.90 pass rate and zero critical
# failures against the real local model.
HIVEPLANE_CERTIFICATION__PRODUCTION__MIN_PRODUCTION_RUNS_SURVIVED=0
