# HivePlane cloud configuration profile (OpenAI). Requires an API key and network access.
# Usage: docker compose --env-file .env.cloud --profile cloud up -d
# See .env.example for the full setting list.

HIVEPLANE_ENVIRONMENT=local
HIVEPLANE_DEBUG=false

HIVEPLANE_MODEL__PROVIDER=cloud
HIVEPLANE_MODEL__BASE_URL=https://api.openai.com/v1
# Fill in a real key in your untracked `.env.cloud.local` (or export it); leave blank otherwise.
HIVEPLANE_MODEL__API_KEY=