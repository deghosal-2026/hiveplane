# HivePlane CI configuration profile (hermetic: fake provider, no network, no secrets).
# Usage: docker compose --env-file .env.ci --profile ci up -d
# See .env.example for the full setting list.

HIVEPLANE_ENVIRONMENT=local
HIVEPLANE_DEBUG=false

# Deterministic in-process replay provider — never touches the network.
HIVEPLANE_MODEL__PROVIDER=fake
# Recorded completions keyed by request hash (see docs/design/corpus-fixture-coupling.md).
# Every corpus task must have an entry; a missing entry fails the task loudly.
# NOTE: requires deploy/testdata inside the image (P3 #143) for container runs.
HIVEPLANE_MODEL__REPLAY_FILE=deploy/testdata/llm/replay.json