{
  "workloads_root": "field_test/workloads",
  "corpora_root": "field_test/corpora",
  "downloaded_field_test_assets_root": "field_test/",
  "note": "The v0.1.0 field test harness registers workloads from field_test/workloads and certifies against field_test/corpora. These manifests point at shims that wrap the downloaded real agents under field_test/agents/.",
  "workloads": {
    "repo-agent": {
      "manifest": "field_test/workloads/repo-agent.yaml",
      "runtime_adapter": "raw-worker",
      "entrypoint": "field_test.shims.repo_agent:run",
      "benchmark_corpus": "corpora/repo-agent/hiveplane-corpus.yaml",
      "benchmark_corpus_path": "field_test/corpora/repo-agent/hiveplane-corpus.yaml",
      "source": "field_test",
      "model_identity": {
        "provider": "openai",
        "family": "gpt-4o",
        "version": "2024-08-06"
      }
    },
    "docs-agent": {
      "manifest": "field_test/workloads/docs-agent.yaml",
      "runtime_adapter": "langgraph",
      "entrypoint": "field_test.shims.docs_agent:graph",
      "benchmark_corpus": "corpora/docs-agent/hiveplane-corpus.yaml",
      "benchmark_corpus_path": "field_test/corpora/docs-agent/hiveplane-corpus.yaml",
      "source": "field_test",
      "model_identity": {
        "provider": "openai",
        "family": "gpt-4o",
        "version": "2024-08-06"
      }
    },
    "incident-agent": {
      "manifest": "field_test/workloads/incident-agent.yaml",
      "runtime_adapter": "langgraph",
      "entrypoint": "field_test.shims.incident_agent:graph",
      "benchmark_corpus": "corpora/incident-agent/hiveplane-corpus.yaml",
      "benchmark_corpus_path": "field_test/corpora/incident-agent/hiveplane-corpus.yaml",
      "source": "field_test",
      "model_identity": {
        "provider": "openai",
        "family": "gpt-4o",
        "version": "2024-08-06"
      }
    }
  }
}